fungsi fib(n) {
    jika n < 2 maka
        kembali n
    akhir
    kembali fib(n - 1) + fib(n - 2)
}
cetak fib(20)
larik arr = [3, 1, 2]
arr = tambah(arr, 9)
cetak panjang(arr)
cetak arr[3]
angka i = 0
selama i < 3 {
    cetak "i=#{i}"
    i += 1
}
teks s = "halo dunia"
cetak hurufBesar(s)
cetak gabungTeks(["a", "b", "c"], "-")
